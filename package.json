{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./lib/**\" build && pnpm -r --filter \"./artifacts/power-play-turf\" build",
    "test": "DATABASE_URL=postgres://mock:mock@localhost:5432/mock RAZORPAY_KEY_ID=mock RAZORPAY_KEY_SECRET=mock tsx --test tests/api.test.ts",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "@types/supertest": "^7.2.0",
    "@vercel/node": "^5.1.14",
    "prettier": "^3.8.3",
    "supertest": "^7.2.2",
    "typescript": "~5.9.3"
  }
}

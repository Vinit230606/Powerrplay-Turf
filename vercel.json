{
  "version": 2,
  "installCommand": "npm install -g pnpm@9.15.0 && pnpm install --ignore-scripts --no-frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/power-play-turf run build",
  "outputDirectory": "artifacts/power-play-turf/dist/public",
  "framework": null,
  "functions": {
    "api/index.ts": {
      "runtime": "@vercel/node@5",
      "includeFiles": "lib/**,artifacts/api-server/src/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
